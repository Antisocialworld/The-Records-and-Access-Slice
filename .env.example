# SQLite database file, relative to prisma/schema.prisma.
# Assessment 1 reasoning applies: no server, no Docker, no hosted signup —
# sufficient for a single-tester slice.
DATABASE_URL="file:./dev.db"

# Session/auth secret, ported from Assessment 1's pattern (database-backed
# sessions). Used to derive/guard session tokens. Generate a real value with:
#   openssl rand -base64 32
# Leave blank in .env.example — the real value lives ONLY in your local .env,
# which is gitignored.
AUTH_SECRET=

# Set to "true" to log every Prisma query (Prisma `log: ['query']`),
# used for the query-count measurements in DOCUMENTATION.md.
# PRISMA_QUERY_LOGGING="true"

# Gmail SMTP for OTP email delivery. Generate an app password at:
#   https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password